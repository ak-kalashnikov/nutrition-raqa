# ============================================
# LLM providers (configure at least one)
# ============================================
# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Default dropdown selection (must match allowlisted id, see /llm/options)
DEFAULT_LLM_ID=groq:llama-3.3-70b-versatile

# Hugging Face — Hub token for index sync + Inference API models
# https://huggingface.co/settings/tokens
HF_TOKEN=
INDEX_HF_REPO_ID=
INDEX_HF_PATH=latest
INDEX_HF_REPO_TYPE=model

# Google Gemini (optional)
GEMINI_API_KEY=

# ============================================
# API
# ============================================
API_PORT=8000
API_HOST=0.0.0.0

# ============================================
# Retriever / FAISS
# ============================================
EMBEDDING_MODEL=all-MiniLM-L6-v2
RELEVANCE_THRESHOLD=0.4
TOP_K=3
# Merged at startup with nutrition_qa.jsonl when no index is already on disk
EXTRA_CORPUS_JSONL=data/open_textbook_chunks.jsonl,data/pressbooks_chapters.jsonl

# ============================================
# Research fallback (Semantic Scholar, arXiv, PubMed)
# ============================================
# Leave false. A chat question must not append papers or upload the index.
RESEARCH_FALLBACK_ENABLED=false
RESEARCH_MAX_CHUNKS_PER_QUERY=12
RESEARCH_GLOBAL_PER_HOUR=40
RESEARCH_S2_LIMIT=5
RESEARCH_ARXIV_LIMIT=3
RESEARCH_PUBMED_LIMIT=5

# ============================================
# Hub upload debounce (seconds after last ingest)
# ============================================
HUB_UPLOAD_DEBOUNCE_SECONDS=90

# ============================================
# Rate limiting (HTTP)
# ============================================
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================
# SSE keep-alive for /query/stream
# ============================================
SSE_KEEPALIVE_SECONDS=15

# ============================================
LOG_LEVEL=INFO
